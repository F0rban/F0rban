{
  "name": "atelier-meridienne",
  "version": "1.0.0",
  "description": "Site vitrine — Atelier Méridienne, gnomonique & fresque murale (projet d'étude fictif)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx http-server . -p 4173 -c-1 -g --silent",
